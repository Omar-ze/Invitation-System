# ──────────────────────────────────────────────────
# Base de données PostgreSQL
# ──────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/invitation_system"

# ──────────────────────────────────────────────────
# Sécurité des sessions (iron-session)
# ──────────────────────────────────────────────────
# Clé secrète de min. 32 caractères — changez-la en production !
SESSION_SECRET="changez-cette-cle-secrete-en-production-min32chars"

# ──────────────────────────────────────────────────
# Environnement
# ──────────────────────────────────────────────────
NODE_ENV="development"
